{
  "$schema": "https://fallow.tools/schema.json",
  "entry": [
    "bridge-server/src/index.ts",
    "bridge-server/src/server.ts"
  ],
  "supportEntry": [
    "bridge-server/src/**/*.test.ts",
    "bridge-server/src/**/__tests__/**/*.ts"
  ],
  "ignorePatterns": [
    "gemini-cli/**"
  ],
  "ignoreDependencies": [
    "@google/genai"
  ],
  "ignoreBinaries": [
    "vsce"
  ],
  "duplicates": {
    "enabled": true,
    "mode": "semantic",
    "minTokens": 120,
    "minLines": 25
  },
  "health": {
    "maxCyclomatic": 45,
    "maxCognitive": 85,
    "maxCrap": 1800,
    "maxUnitSize": 260
  },
  "rules": {
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error",
    "unused-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-class-members": "error",
    "duplicate-exports": "error",
    "unlisted-dependencies": "error",
    "unlisted-binaries": "error",
    "circular-dependencies": "error",
    "complexity-cyclomatic": "error",
    "complexity-cognitive": "error",
    "complexity-crap": "error",
    "complexity-file-lines": "error"
  }
}

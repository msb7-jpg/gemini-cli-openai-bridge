{
  "name": "@migueldsbatista/gemini-cli-openai-bridge",
  "version": "0.1.16",
  "description": "High-performance OpenAI (/v1/chat/completions) & Anthropic (/v1/messages) bridge for Google Gemini CLI. Tailored for OpenCode, Claude Code, Roo Code & Aider.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gemini-bridge": "dist/index.js",
    "gemini-cli-bridge": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msb7-jpg/gemini-cli-openai-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/msb7-jpg/gemini-cli-openai-bridge/issues"
  },
  "homepage": "https://github.com/msb7-jpg/gemini-cli-openai-bridge#readme",
  "author": "Miguel de Sousa Batista",
  "license": "Apache-2.0",
  "keywords": [
    "gemini",
    "gemini-cli",
    "claude-code",
    "opencode",
    "openai-compatible",
    "anthropic-messages",
    "function-calling",
    "tool-calling",
    "thinking-models",
    "thought-signature",
    "gemini-3.8-flash",
    "gemini-2.5-pro",
    "ai-agents",
    "coding-assistant"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "debug": "node --inspect-brk dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@google/gemini-cli-core": "0.1.13",
    "command-exists": "^1.2.9",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "openai": "^5.8.2",
    "read-package-up": "^11.0.0",
    "strip-json-comments": "^3.1.1",
    "undici": "^6.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.1.0",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}

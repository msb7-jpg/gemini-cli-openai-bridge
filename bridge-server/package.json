{
  "name": "@migueldsbatista/gemini-cli-openai-bridge",
  "version": "0.5.1",
  "description": "High-performance OpenAI (/v1/chat/completions) & Anthropic (/v1/messages) bridge for Google Gemini CLI. Tailored for OpenCode, Claude Code, Roo Code & Aider.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gemini-bridge": "dist/index.js",
    "gemini-cli-bridge": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msb7-jpg/gemini-cli-openai-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/msb7-jpg/gemini-cli-openai-bridge/issues"
  },
  "homepage": "https://github.com/msb7-jpg/gemini-cli-openai-bridge#readme",
  "author": "Miguel de Sousa Batista",
  "license": "Apache-2.0",
  "keywords": [
    "gemini",
    "gemini-cli",
    "claude-code",
    "opencode",
    "openai-compatible",
    "anthropic-messages",
    "function-calling",
    "tool-calling",
    "thinking-models",
    "thought-signature",
    "gemini-3.8-flash",
    "gemini-2.5-pro",
    "ai-agents",
    "coding-assistant"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../scripts/build_package.js",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "debug": "node --inspect-brk dist/index.js",
    "lint": "oxlint -c .oxlintrc.json bridge-server/src",
    "lint:fix": "oxlint --fix -c .oxlintrc.json bridge-server/src",
    "format": "oxfmt bridge-server/src",
    "format:check": "oxfmt --check bridge-server/src",
    "fallow": "fallow",
    "check": "npm run lint && npm run format:check && npm run fallow && npm test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@google/gemini-cli-core": "0.1.13",
    "command-exists": "^1.2.9",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^6.0.0",
    "strip-json-comments": "^3.1.1",
    "yargs": "^17.7.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "fallow": "^3.40.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18"
  }
}
